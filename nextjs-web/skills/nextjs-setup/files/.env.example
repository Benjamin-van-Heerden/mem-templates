# development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon. Development uses the project's `dev` branch, production its `main` branch:
#   neon connection-string dev --project-id <id> --pooled   -> DATABASE_URL (the app)
#   neon connection-string dev --project-id <id>            -> DATABASE_URL_UNPOOLED (migrations, seed)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Generate with `openssl rand -hex 32`, a different one per environment. BETTER_AUTH_URL must equal NEXT_PUBLIC_APP_URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The one super admin. scripts/seed.ts creates or updates this account on every build; change these and redeploy to rotate.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=

# Vercel Cron sends this as a bearer token. Generate with `openssl rand -hex 16`.
CRON_SECRET=

# Optional: leave empty when not configured.
RESEND_API_KEY=
