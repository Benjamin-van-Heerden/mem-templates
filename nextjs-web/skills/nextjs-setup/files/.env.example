# development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pooled URL for the app; unpooled (direct) URL for migrations. Locally both point at the same database.
DATABASE_URL=postgres://postgres@localhost:5432/app
DATABASE_URL_UNPOOLED=postgres://postgres@localhost:5432/app

# Generate with `openssl rand -hex 32`. BETTER_AUTH_URL must equal NEXT_PUBLIC_APP_URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Cron sends this as a bearer token. Generate with `openssl rand -hex 16`.
CRON_SECRET=

# Optional: leave empty when not configured.
RESEND_API_KEY=
